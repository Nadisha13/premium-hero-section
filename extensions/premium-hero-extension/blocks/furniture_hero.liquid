{{ 'premium-templates.css' | asset_url | stylesheet_tag }}

{%- assign primary_color = block.settings.primary_color -%}
{%- assign secondary_color = block.settings.secondary_color -%}
{%- assign heading = block.settings.heading -%}
{%- assign description = block.settings.description -%}
{%- assign button_text = block.settings.button_text -%}
{%- assign bg_image = block.settings.bg_image -%}
{%- assign template_id = block.settings.template_id -%}

<div 
  id="premium-hero-wrapper-{{ block.id }}"
  class="hero-template-wrapper tpl-{{ template_id }}"
  style="background-color: {{ secondary_color }}; background-image: linear-gradient(135deg, {{ secondary_color }} 0%, rgba(10,10,10,0.15) 100%); min-height: 500px; padding: 4rem 2rem;"
>
  {%- if bg_image != blank -%}
    <img
      id="premium-hero-bg-{{ block.id }}"
      class="hero-media-bg"
      src="{{ bg_image | image_url: width: 1500 }}"
      alt="Hero Background"
      style="opacity: 0.4;"
      width="{{ bg_image.width }}"
      height="{{ bg_image.height }}"
    />
  {%- endif -%}

  <div class="hero-media-overlay overlay-pro"></div>

  <div class="hero-layout-content hero-layout-centered" style="z-index: 10; position: relative;">
    <div style="max-width: 750px; margin: 0 auto; text-align: center;">
      <h1 
        id="premium-hero-heading-{{ block.id }}" 
        class="hero-tagline" 
        style="color: {{ primary_color }}; text-shadow: 0 2px 10px rgba(0,0,0,0.5);"
      >
        {{ heading }}
      </h1>
      
      <p 
        id="premium-hero-description-{{ block.id }}" 
        class="hero-description" 
        style="text-shadow: 0 1px 5px rgba(0,0,0,0.5);"
      >
        {{ description }}
      </p>

      <!-- Customer Subscription Form -->
      <div style="background: rgba(15, 23, 42, 0.75); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px; padding: 2rem; max-width: 460px; width: 100%; margin: 2.5rem auto 0 auto; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35); backdrop-filter: blur(12px); text-align: left;">
        <form action="/apps/premium-hero-proxy" method="POST" id="premium-hero-form-{{ block.id }}">
          <input type="hidden" name="templateId" value="{{ template_id }}">
          
          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div style="display: flex; flex-direction: column; gap: 0.3rem;">
              <label style="color: #94a3b8; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;" for="hero-name-{{ block.id }}">Full Name</label>
              <input
                id="hero-name-{{ block.id }}"
                name="name"
                type="text"
                placeholder="John Doe"
                required
                style="background: #0f172a; color: white; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px; padding: 0.75rem 1rem; width: 100%; font-size: 0.95rem; box-sizing: border-box;"
              />
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 0.3rem;">
              <label style="color: #94a3b8; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;" for="hero-email-{{ block.id }}">Email Address</label>
              <input
                id="hero-email-{{ block.id }}"
                name="email"
                type="email"
                placeholder="john@example.com"
                required
                style="background: #0f172a; color: white; border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 8px; padding: 0.75rem 1rem; width: 100%; font-size: 0.95rem; box-sizing: border-box;"
              />
            </div>

            <button 
              id="premium-hero-btn-{{ block.id }}"
              type="submit"
              style="background: {{ primary_color }}; color: white; border: none; padding: 0.9rem; border-radius: 8px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: opacity 0.2s; width: 100%;"
            >
              {{ button_text }}
            </button>
          </div>
        </form>
        <div id="premium-hero-status-{{ block.id }}" style="display: none; margin-top: 1rem; padding: 0.75rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; text-align: center;"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var templateId = "{{ template_id }}";
    var shop = "{{ shop.permanent_domain }}";
    var blockId = "{{ block.id }}";

    // 1. Fetch customized template settings from App Proxy
    fetch("/apps/premium-hero-proxy?template_id=" + encodeURIComponent(templateId) + "&shop=" + encodeURIComponent(shop))
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data && data.success && data.customization) {
          var cust = data.customization;
          
          if (cust.heading) {
            document.getElementById("premium-hero-heading-" + blockId).innerText = cust.heading;
          }
          if (cust.description) {
            document.getElementById("premium-hero-description-" + blockId).innerText = cust.description;
          }
          if (cust.buttonText) {
            document.getElementById("premium-hero-btn-" + blockId).innerText = cust.buttonText;
          }
          if (cust.primaryColor) {
            document.getElementById("premium-hero-heading-" + blockId).style.color = cust.primaryColor;
            document.getElementById("premium-hero-btn-" + blockId).style.backgroundColor = cust.primaryColor;
          }
          if (cust.secondaryColor) {
            document.getElementById("premium-hero-wrapper-" + blockId).style.backgroundColor = cust.secondaryColor;
            document.getElementById("premium-hero-wrapper-" + blockId).style.backgroundImage = "linear-gradient(135deg, " + cust.secondaryColor + " 0%, rgba(10,10,10,0.15) 100%)";
          }
          if (cust.image) {
            var bgImg = document.getElementById("premium-hero-bg-" + blockId);
            if (bgImg) {
              bgImg.src = cust.image;
            } else {
              var wrapper = document.getElementById("premium-hero-wrapper-" + blockId);
              var img = document.createElement("img");
              img.id = "premium-hero-bg-" + blockId;
              img.className = "hero-media-bg";
              img.src = cust.image;
              img.alt = "Hero Background";
              img.style.opacity = "0.4";
              img.width = 1500;
              img.height = 800;
              wrapper.insertBefore(img, wrapper.firstChild);
            }
          }
        }
      })
      .catch(function(err) {
        console.error("Error fetching hero settings:", err);
      });

    // 2. Handle AJAX Submission
    var form = document.getElementById("premium-hero-form-" + blockId);
    var statusDiv = document.getElementById("premium-hero-status-" + blockId);
    
    if (form) {
      form.addEventListener("submit", function(e) {
        e.preventDefault();
        var formData = new FormData(form);
        
        fetch("/apps/premium-hero-proxy", {
          method: "POST",
          body: formData
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data && data.success) {
            statusDiv.style.display = "block";
            statusDiv.style.background = "#e8f5e9";
            statusDiv.style.color = "#2e7d32";
            statusDiv.innerText = "✓ Thank you! You have successfully subscribed.";
            form.reset();
          } else {
            statusDiv.style.display = "block";
            statusDiv.style.background = "#ffebee";
            statusDiv.style.color = "#c62828";
            statusDiv.innerText = "✗ Something went wrong. Please try again.";
          }
        })
        .catch(function(err) {
          statusDiv.style.display = "block";
          statusDiv.style.background = "#ffebee";
          statusDiv.style.color = "#c62828";
          statusDiv.innerText = "✗ Error submitting form. Please try again.";
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Furniture Hero Section",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "template_id",
      "label": "Template ID",
      "default": "furniture-premium"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hero Heading",
      "default": "Architectural Interior Consultations"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Hero Description",
      "default": "Cinematic luxury interior walkthrough videos with slow camera pans and designer atmosphere."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "CTA Button Text",
      "default": "Schedule Planning Session"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#022c22"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Background Color",
      "default": "#141716"
    }
  ]
}
{% endschema %}
