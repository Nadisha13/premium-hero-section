{{ 'premium-templates.css' | asset_url | stylesheet_tag }}

{%- assign primary_color = block.settings.primary_color -%}
{%- assign secondary_color = block.settings.secondary_color -%}
{%- assign heading = block.settings.heading -%}
{%- assign description = block.settings.description -%}
{%- assign button_text = block.settings.button_text -%}
{%- assign bg_image = block.settings.bg_image -%}
{%- assign template_id = block.settings.template_id -%}

<div 
  id="premium-hero-wrapper-{{ block.id }}"
  class="hero-template-wrapper tpl-{{ template_id }}"
  style="background-color: {{ secondary_color }}; background-image: linear-gradient(135deg, {{ secondary_color }} 0%, rgba(10,10,10,0.15) 100%); min-height: 500px; padding: 4rem 2rem;"
>
  {%- if bg_image != blank -%}
    <img
      id="premium-hero-bg-{{ block.id }}"
      class="hero-media-bg"
      src="{{ bg_image | image_url: width: 1500 }}"
      alt="Hero Background"
      style="opacity: 0.4;"
      width="{{ bg_image.width }}"
      height="{{ bg_image.height }}"
    />
  {%- endif -%}

  <div class="hero-media-overlay overlay-pro"></div>

  <div class="hero-layout-content hero-layout-centered" style="z-index: 10; position: relative;">
    <div style="max-width: 750px; margin: 0 auto; text-align: center;">
      <h1 
        id="premium-hero-heading-{{ block.id }}" 
        class="hero-tagline" 
        style="color: {{ primary_color }}; text-shadow: 0 2px 10px rgba(0,0,0,0.5);"
      >
        {{ heading }}
      </h1>
      
      <p 
        id="premium-hero-description-{{ block.id }}" 
        class="hero-description" 
        style="text-shadow: 0 1px 5px rgba(0,0,0,0.5);"
      >
        {{ description }}
      </p>

      <!-- Real Hero Section CTA Button (No forms) -->
      <div style="margin-top: 2.5rem; display: flex; justify-content: center;">
        <a 
          id="premium-hero-btn-{{ block.id }}"
          href="#"
          style="background: {{ primary_color }}; color: white; border: none; padding: 1rem 2.5rem; border-radius: 8px; font-size: 1.1rem; font-weight: 800; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; text-decoration: none; display: inline-block; box-shadow: 0 10px 25px rgba(0,0,0,0.4);"
          onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 15px 30px rgba(0,0,0,0.5)';"
          onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 10px 25px rgba(0,0,0,0.4)';"
        >
          {{ button_text }}
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var templateId = "{{ template_id }}";
    var shop = "{{ shop.permanent_domain }}";
    var blockId = "{{ block.id }}";

    // 1. Fetch customized template settings from App Proxy
    fetch("/apps/premium-hero-proxy?template_id=" + encodeURIComponent(templateId) + "&shop=" + encodeURIComponent(shop))
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data && data.success && data.customization) {
          var cust = data.customization;
          
          if (cust.heading) {
            document.getElementById("premium-hero-heading-" + blockId).innerText = cust.heading;
          }
          if (cust.description) {
            document.getElementById("premium-hero-description-" + blockId).innerText = cust.description;
          }
          if (cust.buttonText) {
            document.getElementById("premium-hero-btn-" + blockId).innerText = cust.buttonText;
          }
          if (cust.primaryColor) {
            document.getElementById("premium-hero-heading-" + blockId).style.color = cust.primaryColor;
            document.getElementById("premium-hero-btn-" + blockId).style.backgroundColor = cust.primaryColor;
          }
          if (cust.secondaryColor) {
            document.getElementById("premium-hero-wrapper-" + blockId).style.backgroundColor = cust.secondaryColor;
            document.getElementById("premium-hero-wrapper-" + blockId).style.backgroundImage = "linear-gradient(135deg, " + cust.secondaryColor + " 0%, rgba(10,10,10,0.15) 100%)";
          }
          if (cust.image) {
            var bgImg = document.getElementById("premium-hero-bg-" + blockId);
            if (bgImg) {
              bgImg.src = cust.image;
            } else {
              var wrapper = document.getElementById("premium-hero-wrapper-" + blockId);
              var img = document.createElement("img");
              img.id = "premium-hero-bg-" + blockId;
              img.className = "hero-media-bg";
              img.src = cust.image;
              img.alt = "Hero Background";
              img.style.opacity = "0.4";
              img.width = 1500;
              img.height = 800;
              wrapper.insertBefore(img, wrapper.firstChild);
            }
          }
        }
      })
      .catch(function(err) {
        console.error("Error fetching hero settings:", err);
      });
  });
</script>

{% schema %}
{
  "name": "Jewelry Hero Section",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "template_id",
      "label": "Template ID",
      "default": "jewelry-premium"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hero Heading",
      "default": "Bespoke Jewelry Consultations"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Hero Description",
      "default": "Sparkling diamond cinematic video with flashy luxury motion and animated glow."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "CTA Button Text",
      "default": "Book Artisan Consult"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#d4af37"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Background Color",
      "default": "#0f172a"
    }
  ]
}
{% endschema %}
